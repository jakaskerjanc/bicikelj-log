# Copy to .env.local (gitignored). A Mapbox public token restricted to the site URL and localhost.
VITE_MAPBOX_TOKEN=pk.your-token
# The backend's publicBaseUrl deploy output, e.g. https://bicikeljpub<unique>.blob.core.windows.net/typical/v1/
# For synthetic local data run `npm run fake-data` and use /dev-data/v1/
VITE_DATA_BASE_URL=
